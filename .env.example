# Kuukan configuration. Variable names match jikan-rest where the meaning is the
# same, so an existing Jikan .env can be reused.

APP_ENV=production
APP_DEBUG=false
APP_VERSION=4.2.2

# Storage (SQLite + Tantivy). Defaults work for local development.
KUUKAN_DB_PATH=data/kuukan.db
KUUKAN_SEARCH_PATH=data/search

# MyAnimeList source
SOURCE_TIMEOUT=10
# KUUKAN_MAL_PROXY=http://127.0.0.1:8888
# KUUKAN_MAL_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36

# Endpoints
MAX_RESULTS_PER_PAGE=25
DISABLE_USER_LISTS=false
INSIGHTS=false

# Caching (seconds)
CACHE_DEFAULT_EXPIRE=86400
CACHE_USER_EXPIRE=300
CACHE_USERLIST_EXPIRE=3600
CACHE_SEARCH_EXPIRE=432000
CACHE_MAGAZINE_EXPIRE=432000
CACHE_GENRE_EXPIRE=432000
MICROCACHING=false
MICROCACHING_EXPIRE=5

# CORS
CORS_MIDDLEWARE=false

# Optional public-API style rate limiting
KUUKAN_RATE_LIMIT=false
KUUKAN_RATE_LIMIT_PER_SECOND=3
KUUKAN_RATE_LIMIT_PER_MINUTE=60
